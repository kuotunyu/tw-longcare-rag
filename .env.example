# === API 金鑰（填入真值後另存為 .env；.env 已列入 .gitignore）===
GOOGLE_API_KEY=
# GOOGLE_API_KEY 的別名（二擇一填即可；GOOGLE_API_KEY 優先）
GEMINI_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
DISCORD_WEBHOOK_URL=

# === 雲端模型字串（程式不寫死，一律由此設定；字串有效性查證日期 2026-07-20）===
# 主力生成 / Agent / VLM
GEMINI_MODEL=gemini-3.1-flash-lite
# 大量一次性前處理（chunk 摘要、合成資料）：D8 決策統一與 GEMINI_MODEL 同一模型
# （$0.25/$1.50 per 1M；原選 gemini-2.5-flash-lite 更便宜但為求全案模型單一化改此）
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
# 評審（LLM-as-judge）與第二供應商
# ⚠️ 落日註記：gpt-5-mini 對應之 snapshot 官方已公告 2026-12-11 關閉，
#    屆時改為官方指定後繼 gpt-5.4-mini（成本約 2.5 倍）即可，程式碼不用動
OPENAI_MODEL=gpt-5-mini

# === 地端模型（Ollama）===
OLLAMA_MODEL=taide-gemma3-12b

# === 檢索模型（HF model id；gated 模型需先於 HF 網頁接受授權）===
EMBEDDING_MODEL=taide/embeddinggemma-GTAIDE-300m-2605
# 評估對照基準（build_index --embedding bge-m3 時使用）
EMBEDDING_BASELINE_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# === Adaptive shadow（預設不改 baseline control path）===
RAG_SHADOW_ADAPTIVE=false
# 只有 shadow gate 要求 refine_once 時才多跑一次修正；會增加延遲與 token
RAG_SHADOW_REFINEMENT=false

# === Local JSONL trace policy ===
RAG_TRACE_SAMPLE_RATE=1.0
RAG_TRACE_REDACT_PII=false
RAG_TRACE_RETENTION_DAYS=30
RAG_TRACE_KEEP_ERRORS=true

# === Production persistent storage（本機留空即使用 repo/data 與 repo/logs）===
# HF Space 可掛載 Storage Bucket volume，再把此值設成自選 mount path 下的 data
RAG_DATA_DIR=
# Trace 也可放同一 volume 的 logs 子目錄
RAG_LOGS_DIR=
