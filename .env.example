# === API 金鑰（填入真值後另存為 .env；.env 已列入 .gitignore）===
GOOGLE_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
DISCORD_WEBHOOK_URL=

# === 雲端模型字串（程式不寫死，一律由此設定；字串有效性查證日期 2026-07-20）===
# 主力生成 / Agent / VLM
GEMINI_MODEL=gemini-3.1-flash-lite
# 大量一次性前處理（chunk 摘要、合成資料）：最便宜（$0.10/$0.40 per 1M），目前仍為 stable
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
# 評審（LLM-as-judge）與第二供應商
# ⚠️ 落日註記：gpt-5-mini 對應之 snapshot 官方已公告 2026-12-11 關閉，
#    屆時改為官方指定後繼 gpt-5.4-mini（成本約 2.5 倍）即可，程式碼不用動
OPENAI_MODEL=gpt-5-mini

# === 地端模型（Ollama）===
OLLAMA_MODEL=taide-gemma3-12b
